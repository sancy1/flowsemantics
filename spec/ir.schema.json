{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowsemantics.dev/spec/ir.schema.json",
  "title": "FlowSemantics Portable IR",
  "description": "Canonical representation of a PORTABLE FlowContract (SPEC.md section 14.2). Must not carry host-language lambdas, serialized code, or host types outside the portable expression subset.",
  "type": "object",
  "required": ["spec_version", "flow_id", "portability", "mode", "rules"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "type": "string" },
    "flow_id": { "type": "string" },
    "portability": { "const": "PORTABLE" },
    "mode": { "enum": ["FirstMatch", "AllMatch", "Priority"] },
    "contract_version": { "type": "string" },
    "fallback": {
      "type": ["object", "null"],
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["default_if_no_match", "otherwise"] },
        "value": {}
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "kind"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["when", "when_not", "then"] },
        "condition": { "$ref": "#/$defs/expr" },
        "guard": { "$ref": "#/$defs/expr" },
        "transform": { "$ref": "#/$defs/expr" },
        "priority": { "type": "integer" },
        "effective_from": { "type": ["string", "null"] },
        "effective_until": { "type": ["string", "null"] },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "payload": {}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "expr": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "field", "const", "eq", "ne", "lt", "le", "gt", "ge",
            "and", "or", "not", "is_null", "is_not_null", "in", "not_in"
          ]
        },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/expr" }
        },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
