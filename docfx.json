{
  "metadata": [
    {
      "src": [
        {
          "files": [ "FlowSemantics/FlowSemantics.csproj" ],
          "src": "csharp"
        }
      ],
      "dest": "csharp/api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**/*.yml", "index.md", "toc.yml" ],
        "src": "csharp"
      }
    ],
    "dest": "site/csharp",
    "template": [ "default" ],
    "globalMetadata": {
      "_appTitle": "FlowSemantics (C#)",
      "_appFooter": "Apache-2.0 — github.com/sancy1/flowsemantics"
    }
  }
}
