{
  "name": "flow-semantics-ts",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "FlowSemantics TypeScript implementation — conformance target per SPEC 14.5",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "conformance": "node src/runner.ts --vectors ../conformance/vectors",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6"
  }
}
