# filepath: .gitattributes
# layer: Tooling
# module: n/a (root)
# since: 0.0.0
# purpose: Normalize line endings and classify text vs binary for git
# NOTES:
#   - All text is LF, matching .editorconfig.
#   - Binary files are explicitly marked so git does not normalize them.

* text=auto eol=lf

*.py       text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.txt      text eol=lf

*.whl      binary
*.zip      binary
*.png      binary
*.jpg      binary
*.pdf      binary

